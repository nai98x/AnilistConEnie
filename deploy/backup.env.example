# Copiar a ~/.config/anilist-backup/backup.env en el server (chmod 600).
# Este archivo NO se versiona con valores reales.

PGDATABASE=
PGUSER=
PGHOST=
PGPORT=

# Remote de rclone + bucket + carpeta. La retención solo mira dentro de esta carpeta.
REMOTE=nombre_remote:nombre_bucket/carpeta

# Prefijo de los archivos: <PREFIJO>-AAAA-MM-DD.dump.gpg
PREFIJO=backup

# Cuántas copias se conservan.
RETENER=5

PASSFILE=$HOME/.config/anilist-backup/passphrase
RCLONE=$HOME/bin/rclone

# Marca del último backup correcto. La lee el bot para avisar si un día no hubo backup;
# tiene que coincidir con Backups:RutaEstado de appsettings.json.
ESTADO=$HOME/.config/anilist-backup/ultimo-ok

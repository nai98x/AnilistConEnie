{
  "title": "AnilistConEnie",
  "uid": "anilistconenie-bot",
  "tags": [
    "anilistconenie",
    "discord"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Métricas",
        "type": "datasource",
        "query": "prometheus",
        "regex": ".*-prom$",
        "current": {},
        "hide": 0
      },
      {
        "name": "ds_loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": ".*-logs$",
        "current": {},
        "hide": 0
      },
      {
        "name": "nivel",
        "label": "Nivel de logs",
        "type": "custom",
        "query": "fatal,error,warn,info",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Estado",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1

    {
      "type": "timeseries",
      "title": "Mensajes por hora",
      "description": "Ritmo de mensajes del servidor llevado a mensajes por hora. Conversación: mensajes de personas que dan XP. Personas sin XP: mensajes en canales sin XP (bots, comandos) o que son solo un emote/sticker. Bots: mensajes de cualquier bot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (kind) (rate(bot_messages_total{job=~\".*/anilistconenie\"}[$__rate_interval])) * 3600",
          "refId": "A",
          "legendFormat": "{{kind}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "activity"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Conversación (da XP)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Personas sin XP (canales de bots / solo emote)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bot"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Bots"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      }
